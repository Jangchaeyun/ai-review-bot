# 예시입니다. 실제 값은 .env에만 두고 커밋하지 않습니다.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=ai-review-bot
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-app-private-key\n-----END PRIVATE KEY-----"
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_MS=10000
REVIEW_MAX_FILES=20
REVIEW_MAX_FILE_BYTES=204800
REVIEW_MAX_DIFF_BYTES=20480
REVIEW_MAX_INLINE_COMMENTS=10
REVIEW_STATE_PATH=data/review-bot.sqlite
LLM_API_KEY=replace-with-llm-api-key
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_INPUT_CHARS=48000
